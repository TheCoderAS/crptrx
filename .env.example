# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL 14+)
DATABASE_URL=postgresql://usdt:CHANGE_ME@db:5432/usdt
# Only if you use the bundled db service (docker compose --profile bundled-db up -d)
POSTGRES_PASSWORD=CHANGE_ME

# Public URL of the site (used in emails and cookie security)
APP_URL=https://exchange.example.com
SECURE_COOKIES=true

# 32 random bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts PAN, bank account numbers and 2FA secrets. Losing it makes that data unreadable. Back it up.
ENCRYPTION_KEY=
LINK_SIGNING_SECRET=

# Test helpers. MUST be false in production.
DEV_LOGIN_ENABLED=false
DEV_TOOLS_ENABLED=false
AUTO_GENERATE_SECRETS=false

# Firebase (Google sign-in for users). From Firebase console > Project settings > Your apps (Web).
# Also add your domain under Authentication > Settings > Authorized domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Email: resend | console
EMAIL_PROVIDER=resend
EMAIL_FROM="Exchange <no-reply@example.com>"
RESEND_API_KEY=

# SMS OTP: msg91 | console
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ID document storage: s3 (India region, private bucket) | local
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# S3_ENDPOINT=          # only for S3-compatible providers other than AWS
# AWS_ACCESS_KEY_ID=    # or use an instance role
# AWS_SECRET_ACCESS_KEY=

# Blockchain data
TRONGRID_API_KEY=
TRON_TEST_API_URL=https://nile.trongrid.io
TRON_LIVE_API_URL=https://api.trongrid.io
BSC_TEST_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Paid provider with eth_getLogs + "finalized" support (NodeReal, QuickNode, Ankr...)
BSC_LIVE_RPC_URL=
BSC_LIVE_RPC_BACKUP_URL=

# First-run only: creates the super admin when no admin exists.
SEED_SUPER_ADMIN_EMAIL=owner@example.com
SEED_SUPER_ADMIN_PASSWORD=

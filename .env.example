# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database (PostgreSQL 14+)
DATABASE_URL=postgresql://usdt:CHANGE_ME@db:5432/usdt
# Supabase: Project Settings > Database > Connect > "Session pooler" string (works over IPv4),
# with your database password filled in and "?sslmode=require&connection_limit=5" added at the end.
# Example: postgresql://postgres.abcdefgh:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5
# Only if you use the bundled db service (docker compose --profile bundled-db up -d)
POSTGRES_PASSWORD=CHANGE_ME

# Public URL of the site (used in emails and cookie security)
APP_URL=https://exchange.example.com
# How many reverse proxies you run in front of the app (each adds one X-Forwarded-For entry).
# Used for rate limits and the admin IP allow-list. 1 = one HTTPS proxy (nginx, Caddy, a load balancer).
# 0 = no proxy: per-IP limits then fall back to one shared bucket.
TRUSTED_PROXY_HOPS=1
SECURE_COOKIES=true

# 32 random bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts PAN, bank account numbers and 2FA secrets. Losing it makes that data unreadable. Back it up.
ENCRYPTION_KEY=
LINK_SIGNING_SECRET=

# LIVE (real networks, real money) or TEST. Fixed per server: the live app
# (main branch) runs LIVE, staging runs TEST. Required in production: the app
# refuses to start without it.
APP_MODE=TEST

# Test helpers. Ignored (always off) when APP_MODE=LIVE.
DEV_LOGIN_ENABLED=false
DEV_TOOLS_ENABLED=false
AUTO_GENERATE_SECRETS=false

# Firebase (Google sign-in for users). From Firebase console > Project settings > Your apps (Web).
# Also add your domain under Authentication > Settings > Authorized domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Live chat updates and push notifications. Without these, chat still works
# but checks for new messages every few seconds instead of instantly.
# Project settings > Service accounts > Generate new private key: paste the file's contents (or base64 of it).
FIREBASE_SERVICE_ACCOUNT=
# Realtime Database > Data: the address at the top. Load firebase/database.rules.json under Rules.
FIREBASE_DATABASE_URL=
# Project settings > General > Your apps (Web) > messagingSenderId.
FIREBASE_MESSAGING_SENDER_ID=
# Project settings > Cloud Messaging > Web configuration > Key pair (public key).
FIREBASE_VAPID_KEY=

# Email: resend | console
EMAIL_PROVIDER=resend
EMAIL_FROM="Exchange <no-reply@example.com>"
RESEND_API_KEY=

# SMS OTP: msg91 | console
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ID documents: "supabase" (private bucket, production) | "local" (Docker volume, testing)
STORAGE_DRIVER=supabase
# Supabase > Project Settings > API: project URL and the service_role key (server only, keep secret)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# A PRIVATE bucket (Storage > New bucket, "Public" off)
SUPABASE_STORAGE_BUCKET=kyc

# Blockchain data
TRONGRID_API_KEY=
TRON_TEST_API_URL=https://nile.trongrid.io
TRON_LIVE_API_URL=https://api.trongrid.io
# Must support eth_getLogs (bnbchain data-seed nodes do not). Checked weekly by the chain-check workflow.
BSC_TEST_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# Paid provider with eth_getLogs + "finalized" support (NodeReal, QuickNode, Ankr...)
BSC_LIVE_RPC_URL=
BSC_LIVE_RPC_BACKUP_URL=

# First-run only: creates the super admin when no admin exists.
SEED_SUPER_ADMIN_EMAIL=owner@example.com
SEED_SUPER_ADMIN_PASSWORD=

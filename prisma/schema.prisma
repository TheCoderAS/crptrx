// USDT -> INR exchange, Release 1 data model.
// Money: USDT as Decimal(38,18), rupees as Decimal(14,2). Never floats.
// History tables (OrderEvent, SettingsHistory, AuditLog) are append-only,
// enforced by database triggers created in the migration SQL.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Network {
  TRON
  BSC
}

enum NetworkMode {
  TEST
  LIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  NEEDS_CHANGES
  DECLINED
}

enum PayoutType {
  BANK
  UPI
}

enum PayoutStatus {
  PENDING
  APPROVED
  DECLINED
}

enum OrderStatus {
  QUOTE_READY
  EXPIRED
  PAYMENT_SUBMITTED
  PAYMENT_CONFIRMED
  UNDER_REVIEW
  ON_HOLD
  APPROVED
  PAID
  CLOSED_MANUAL
}

enum ActorType {
  USER
  ADMIN
  SYSTEM
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum TransferStatus {
  MATCHED
  UNMATCHED
  MANUAL_HANDLING
  IGNORED_WRONG_TOKEN
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  emailVerified    Boolean    @default(false)
  firebaseUid      String?    @unique
  mobile           String?
  mobileVerifiedAt DateTime?
  displayName      String?
  passwordHash     String?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  status           UserStatus @default(ACTIVE)
  kycStatus        KycStatus  @default(NOT_STARTED)
  // The admin who brought this customer (invite code at sign-up). Null = house (super admin only).
  adminId          String?
  referredAt       DateTime?
  // Bonus on each order, as % of the order value, paid from the margin share of whoever owns
  // the customer (their admin, or the house). Capped at that share. 0 = none.
  rewardPercent    Decimal    @default(0) @db.Decimal(7, 4)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  admin Admin? @relation("AdminCustomers", fields: [adminId], references: [id])

  kycSubmissions  KycSubmission[]
  payoutMethods   PayoutMethod[]
  orders          Order[]
  supportMessages SupportMessage[]
  supportThreads  SupportThread[]
  pushDevices     PushDevice[]
  wallets         UserWallet[]
  emailTokens     EmailToken[]

  @@index([adminId])
  @@map("users")
}

model KycSubmission {
  id              String    @id @default(cuid())
  userId          String
  fullName        String
  dob             String // YYYY-MM-DD, no time zone games
  panEncrypted    String
  panMasked       String
  address         String
  panDocKey       String
  aadhaarFrontKey String
  aadhaarBackKey  String
  selfieKey       String
  maskedConfirmed Boolean
  autoApproved    Boolean   @default(false) // approved instantly by the kyc_auto_approve setting
  postReviewedAt  DateTime? // when an admin looked at an auto-approved submission
  postReviewedBy  String?
  // An admin approved their own customer; a super admin gives the final approval.
  recommendedBy   String?
  recommendedAt   DateTime?
  status          KycStatus
  reviewerId      String?
  reason          String?
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  user     User   @relation(fields: [userId], references: [id])
  reviewer Admin? @relation(fields: [reviewerId], references: [id])

  @@index([status, submittedAt])
  @@index([userId, submittedAt])
  @@map("kyc_submissions")
}

model PayoutMethod {
  id                     String       @id @default(cuid())
  userId                 String
  type                   PayoutType
  holderName             String
  accountNumberEncrypted String?
  accountLast4           String?
  ifsc                   String?
  upiId                  String?
  status                 PayoutStatus @default(PENDING)
  reviewerId             String?
  reason                 String?
  isDefault              Boolean      @default(false)
  autoApproved           Boolean      @default(false) // holder name matched the KYC name exactly
  createdAt              DateTime     @default(now())
  reviewedAt             DateTime?
  deletedAt              DateTime?

  user     User   @relation(fields: [userId], references: [id])
  reviewer Admin? @relation(fields: [reviewerId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("payout_methods")
}

model Order {
  id                String      @id // ORD-2026-000123
  seq               Int         @unique @default(autoincrement())
  userId            String
  status            OrderStatus
  network           Network
  networkMode       NetworkMode
  depositAddress    String
  tokenContract     String
  usdtAmount        Decimal     @db.Decimal(38, 18)
  rate              Decimal     @db.Decimal(14, 4)
  gross             Decimal     @db.Decimal(14, 2)
  taxPercent        Decimal     @db.Decimal(7, 4)
  taxHeld           Decimal     @db.Decimal(14, 2)
  feePercent        Decimal     @db.Decimal(7, 4)
  fee               Decimal     @db.Decimal(14, 2)
  gstPercent        Decimal     @db.Decimal(7, 4)
  gstOnFee          Decimal     @db.Decimal(14, 2)
  net               Decimal     @db.Decimal(14, 2)
  feeMin            Decimal?    @db.Decimal(14, 2) // fee limits in force when quoted; null = none
  feeMax            Decimal?    @db.Decimal(14, 2)
  marketRate        Decimal?    @db.Decimal(14, 4) // market price behind the rate; null = unknown
  margin            Decimal?    @db.Decimal(14, 2) // usdt x (market - rate) in rupees; can be negative
  // Fixed at quote time: the customer's admin (null = house), their share of the margin
  // before the reward, and the reward added to the payout (already included in net).
  adminId           String?
  adminSharePercent Decimal?    @db.Decimal(7, 4)
  adminShare        Decimal?    @db.Decimal(14, 2)
  rewardPercent     Decimal?    @db.Decimal(7, 4)
  reward            Decimal     @default(0) @db.Decimal(14, 2)
  payoutMethodId    String
  payoutSnapshot    Json
  quoteExpiresAt    DateTime
  submittedTxid     String?
  txid              String?
  transferPosition  Int?
  senderAddress     String?
  receivedAmount    Decimal?    @db.Decimal(38, 18)
  confirmedAt       DateTime?
  holdReason        String?
  holdMessage       String?
  walletCheckResult String? // CLEAN | SUSPICIOUS
  walletCheckNote   String?
  walletCheckedBy   String?
  utr               String?
  paidAmount        Decimal?    @db.Decimal(14, 2)
  paidAt            DateTime?
  paidByAdminId     String?
  resolutionNote    String?
  returnTxid        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user          User               @relation(fields: [userId], references: [id])
  events        OrderEvent[]
  transfers     IncomingTransfer[]
  support       SupportMessage[]
  supportThread SupportThread?
  notes         AdminNote[]

  @@unique([network, txid, transferPosition])
  @@index([status, createdAt])
  @@index([network, depositAddress, usdtAmount, status])
  @@index([userId, createdAt])
  @@map("orders")
}

model IncomingTransfer {
  id               String         @id @default(cuid())
  network          Network
  txid             String
  transferPosition Int
  tokenContract    String
  toAddress        String
  fromAddress      String
  amount           Decimal        @db.Decimal(38, 18)
  rawAmount        String
  blockNumber      BigInt
  blockTime        DateTime
  status           TransferStatus @default(UNMATCHED)
  matchedOrderId   String?
  handlingNote     String?
  /// Why the app couldn't match it to an order on its own (shown to admins).
  unmatchedReason  String?
  raw              Json
  createdAt        DateTime       @default(now())

  order Order? @relation(fields: [matchedOrderId], references: [id])

  @@unique([network, txid, transferPosition])
  @@index([status])
  @@map("incoming_transfers")
}

model WatcherState {
  network       Network   @id
  cursor        Json // BSC: { lastBlock }, TRON: { [address]: lastTimestampMs }
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
  failingSince  DateTime?
  alertSentAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("watcher_state")
}

model OrderEvent {
  id            String       @id @default(cuid())
  orderId       String
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  actorType     ActorType
  actorId       String?
  publicMessage String?
  privateNote   String?
  createdAt     DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}

model AdminNote {
  id        String   @id @default(cuid())
  orderId   String
  adminId   String
  note      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
  admin Admin @relation(fields: [adminId], references: [id])

  @@map("admin_notes")
}

model SupportMessage {
  id            String   @id @default(cuid())
  orderId       String?
  userId        String
  message       String
  attachmentKey String?
  handled       Boolean  @default(false)
  /// USER (the customer) or ADMIN. Chat replies from support are ADMIN.
  authorType    String   @default("USER")
  adminId       String?
  createdAt     DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@index([handled, createdAt])
  @@index([orderId, createdAt])
  @@map("support_messages")
}

/// One support chat per order: who spoke last, who has read what, open or resolved.
model SupportThread {
  orderId       String    @id
  userId        String
  status        String    @default("OPEN") // OPEN | RESOLVED
  lastMessageAt DateTime
  lastFrom      String // USER | ADMIN
  userReadAt    DateTime?
  adminReadAt   DateTime?
  resolvedAt    DateTime?
  resolvedBy    String?

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([status, lastFrom, lastMessageAt])
  @@index([userId])
  @@map("support_threads")
}

// A phone or browser that gets push notifications for a customer (Firebase Cloud
// Messaging). WEB today; ANDROID / IOS when the apps register their tokens.
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String // WEB | ANDROID | IOS
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// The same for support staff: an admin's browsers get "customer wrote" alerts.
model AdminPushDevice {
  id         String   @id @default(cuid())
  adminId    String
  token      String   @unique
  platform   String // WEB | ANDROID | IOS
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_push_devices")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SettingsHistory {
  id        String   @id @default(cuid())
  key       String
  oldValue  Json?
  newValue  Json
  changedBy String?
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("settings_history")
}

model DepositAddressChange {
  id              String      @id @default(cuid())
  network         Network
  networkMode     NetworkMode
  newAddress      String
  oldAddress      String?
  requestedBy     String
  cancelTokenHash String      @unique
  effectiveAt     DateTime
  cancelledAt     DateTime?
  cancelledBy     String?
  appliedAt       DateTime?
  createdAt       DateTime    @default(now())

  @@index([network, networkMode, effectiveAt])
  @@map("deposit_address_changes")
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

model Admin {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  passwordHash        String
  role                AdminRole   @default(ADMIN)
  totpSecretEncrypted String?
  totpEnabled         Boolean     @default(false)
  status              AdminStatus @default(ACTIVE)
  failedLogins        Int         @default(0)
  lockedUntil         DateTime?
  lastTotpStep        Int? // replay protection
  // Referrals (ADMIN role only): customers who sign up with this code belong to this admin,
  // who earns profitPercent of the rate margin on their paid orders.
  inviteCode          String?     @unique
  profitPercent       Decimal     @default(0) @db.Decimal(7, 4)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  customers      User[]               @relation("AdminCustomers")
  earnings       AdminEarning[]
  settlements    AdminSettlement[]
  payoutRequests AdminPayoutRequest[]
  kycReviews     KycSubmission[]
  payoutReviews  PayoutMethod[]
  notes          AdminNote[]
  pushDevices    AdminPushDevice[]

  @@map("admins")
}

model Session {
  id          String    @id // sha256 of the cookie token
  subjectType String // USER | ADMIN
  subjectId   String
  stage       String    @default("FULL") // ADMIN: PASSWORD_OK -> FULL
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  stepUpAt    DateTime? // ADMIN: last time a 2FA code was entered (login or re-check)

  @@index([subjectType, subjectId])
  @@map("sessions")
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  mobile    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("otp_codes")
}

model RateLimit {
  key       String   @id
  count     Int
  windowEnd DateTime

  @@map("rate_limits")
}

model OutboundMessage {
  id        String   @id @default(cuid())
  channel   String // EMAIL | SMS
  to        String
  subject   String?
  body      String
  provider  String
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("outbound_messages")
}

/// Live USDT/INR price feed status (one row). Operational state, not configuration.
model RateFeedState {
  id             Int       @id @default(1)
  lastOkAt       DateTime?
  lastMarket     Decimal?  @db.Decimal(14, 4)
  baselineMarket Decimal?  @db.Decimal(14, 4) // last accepted market price, for the jump guard
  sources        Json? // latest per-source prices and errors
  lastError      String?
  lastErrorAt    DateTime?
  failingSince   DateTime?
  alertSentAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("rate_feed_state")
}

/// One-time links sent by email (confirm email, reset password). Only the hash is stored.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  purpose   String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Wallets a user says they send USDT from (wallet_registration setting).
model UserWallet {
  id        String    @id @default(cuid())
  userId    String
  network   Network
  address   String // canonical form
  label     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, network])
  @@map("user_wallets")
}

/// Brand files uploaded by the admin (e.g. the logo), stored in the database as base64.
model BrandAsset {
  key       String   @id // "logo"
  mime      String
  data      String // base64
  size      Int
  updatedAt DateTime @updatedAt

  @@map("brand_assets")
}

enum EarningStatus {
  PENDING // owed to the admin
  SETTLED // paid out to the admin (see settlement)
  VOID // cancelled by a super admin (reason kept)
}

/// An admin's share of one paid order's margin, minus the reward their customer got.
model AdminEarning {
  id           String        @id @default(cuid())
  adminId      String
  orderId      String        @unique
  margin       Decimal       @db.Decimal(14, 2)
  sharePercent Decimal       @db.Decimal(7, 4)
  share        Decimal       @db.Decimal(14, 2) // before the reward
  reward       Decimal       @db.Decimal(14, 2)
  amount       Decimal       @db.Decimal(14, 2) // share - reward, never below 0
  status       EarningStatus @default(PENDING)
  settlementId String?
  voidReason   String?
  voidedBy     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  admin      Admin            @relation(fields: [adminId], references: [id])
  settlement AdminSettlement? @relation(fields: [settlementId], references: [id])

  @@index([adminId, status])
  @@map("admin_earnings")
}

/// A payout of pending earnings to an admin, recorded by a super admin.
model AdminSettlement {
  id        String   @id @default(cuid())
  adminId   String
  amount    Decimal  @db.Decimal(14, 2)
  count     Int
  reference String? // bank reference / UTR
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  admin    Admin               @relation(fields: [adminId], references: [id])
  earnings AdminEarning[]
  request  AdminPayoutRequest?

  @@index([adminId, createdAt])
  @@map("admin_settlements")
}

enum PayoutRequestStatus {
  OPEN
  PAID
  DECLINED
  CANCELLED
}

/// An admin asking the super admin to pay out what they're owed. At most one OPEN per admin
/// (partial unique index in the migration). Paying it is the normal settlement.
model AdminPayoutRequest {
  id           String              @id @default(cuid())
  adminId      String
  amount       Decimal             @db.Decimal(14, 2) // owed when asked; the payout may differ
  note         String?
  status       PayoutRequestStatus @default(OPEN)
  settlementId String?             @unique
  reason       String? // why it was declined or closed
  decidedBy    String?
  decidedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  admin      Admin            @relation(fields: [adminId], references: [id])
  settlement AdminSettlement? @relation(fields: [settlementId], references: [id])

  @@index([status, createdAt])
  @@index([adminId, createdAt])
  @@map("admin_payout_requests")
}
